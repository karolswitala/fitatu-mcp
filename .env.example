# Fitatu MCP — environment template.
# Copy to `.env` and fill in. `.env` is gitignored (never commit real secrets).
# NOTE: the app does not auto-load `.env`. Load it before running, e.g.:
#   set -a; source .env; set +a
#   python -m uvicorn fitatu_mcp.server:app --host 0.0.0.0 --port 8000

# ── Required: Fitatu account (used to log in and fetch your data) ──────────────
FITATU_USERNAME=your_fitatu_email@example.com
FITATU_PASSWORD=your_fitatu_password
# App-level API secret (NOT your password). The `api-secret` header value seen on
# authenticated Fitatu web/app API calls (DevTools → Network). Constant per app.
FITATU_API_SECRET=your_api_secret

# ── Required: MCP server auth ─────────────────────────────────────────────────
# Clients must send `Authorization: Bearer <this>` to reach /mcp. Use a long random
# string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=generate_a_long_random_token

# ── Optional: caching / storage ───────────────────────────────────────────────
# SQLite cache file (use an absolute path in Docker; ":memory:" for throwaway runs).
FITATU_DB_FILE=fitatu_nutrition.db
# Re-fetch "today"/yesterday nutrition if cache older than this many seconds.
FITATU_TODAY_TTL_SECONDS=300
# Re-sync body measurements if cache empty or older than this many seconds.
MEASUREMENTS_TTL_SECONDS=3600

# ── Optional: logging / transport hardening ───────────────────────────────────
LOG_LEVEL=INFO
# Set true to enable MCP DNS-rebinding protection (restricts allowed Host headers).
MCP_ENABLE_DNS_REBINDING_PROTECTION=false
# Comma-separated allowed hosts when the above is enabled.
# MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
